<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>FF Overlay Gamer</title>

<style>

body{
    margin:0;
    background:#0f0f0f;
    font-family:Arial;
    color:white;
}

.topo{
    background:orange;
    padding:20px;
    text-align:center;
    font-size:28px;
    font-weight:bold;
    color:black;
}

.container{
    padding:15px;
}

.card{
    background:#1b1b1b;
    border-radius:20px;
    padding:20px;
    box-shadow:0 0 20px orange;
}

button{
    width:100%;
    padding:14px;
    margin-top:10px;
    border:none;
    border-radius:12px;
    background:orange;
    color:black;
    font-size:16px;
    font-weight:bold;
}

.status{
    margin-top:20px;
    text-align:center;
    color:#00ff99;
}

/* FLUTUANTE */

.float{
    position:fixed;
    bottom:20px;
    right:20px;
    width:70px;
    height:70px;
    border-radius:50%;
    background:orange;
    color:black;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:30px;
    box-shadow:0 0 20px orange;
}

.menu{
    display:none;
    position:fixed;
    bottom:100px;
    right:20px;
    width:220px;
    background:#1b1b1b;
    border-radius:20px;
    padding:15px;
    box-shadow:0 0 20px orange;
}

</style>
</head>

<body>

<div class="topo">
FF GAMER OVERLAY
</div>

<div class="container">

<div class="card">

<button onclick="ativar('FPS 360 Visual')">FPS 360 Visual</button>
<button onclick="ativar('Turbo FPS')">Turbo FPS</button>
<button onclick="ativar('Treino de Mira')">Treino de Mira</button>
<button onclick="ativar('Sensi Ultra')">Sensi Ultra</button>
<button onclick="ativar('Booster RAM')">Booster RAM</button>
<button onclick="ativar('HUD Neon')">HUD Neon</button>

<div class="status" id="status">
Sistema iniciado...
</div>

</div>

</div>

<div class="float" onclick="abrir()">
⚡
</div>

<div class="menu" id="menu">

<button onclick="ativar('Modo Elite')">Modo Elite</button>
<button onclick="ativar('Painel VIP')">Painel VIP</button>
<button onclick="ativar('Visual Gamer')">Visual Gamer</button>
<button onclick="ativar('FPS Max')">FPS Max</button>

</div>

<script>

function ativar(nome){
    document.getElementById("status").innerHTML =
    nome + " ativado!";
}

function abrir(){

    let menu = document.getElementById("menu");

    if(menu.style.display == "block"){
        menu.style.display = "none";
    }else{
        menu.style.display = "block";
    }

}

</script>

</body>
</html>
